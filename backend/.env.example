# POP O' BOB POS Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Engine: 'postgres' or 'sqlite'
DATABASE_TYPE=postgres

# PostgreSQL Connection Settings
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pob_pos

# Direct Database URL format:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pob_pos
